# App
PORT=8000
DEBUG=
# Public URL of the API, used to build email verification links.
APP_BASE_URL=http://localhost:8000
# Apply pending database migrations when the API starts (otherwise run `make migrate`).
MIGRATE_ON_START=false

# Database
# DB_TYPE should be one of (memory, mongo, postgres)
DB_TYPE=memory
# DB_TYPE=mongo
DATABASE_URI=
DATABASE_NAME=
# MONGO_MIGRATIONS_CONFIG=./cmd/migrate/mongo.yaml
# DB_TYPE=postgres
# DATABASE_URI=

# JWT (RS256 key pair, PEM)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Auth
# Block the todos API until the user has verified their email.
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Per-client-IP limit on the public /auth endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_BURST=10
# Page the password reset email links to (?token=... is appended). It should ask
# for a new password and call POST /auth/password/reset. Empty means
# APP_BASE_URL + /reset-password.
AUTH_PASSWORD_RESET_URL=

# Passkeys (WebAuthn). RP_ID is the domain passkeys are bound to; ORIGINS are the
# comma-separated origins of the pages that may use them. Both default to
# APP_BASE_URL. Set them when the web client runs on another origin, e.g.
# PASSKEY_RP_ID=example.com and PASSKEY_ORIGINS=https://app.example.com.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Todos
PASSKEY_ORIGINS=

# SMTP for verification and password reset emails. Leave SMTP_HOST empty to log emails instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Integration tests (`make test-integration` sets these for its Docker databases)
# TEST_POSTGRES_URI=postgres://postgres:postgres@localhost:55432/postgres?sslmode=disable
# TEST_MONGO_URI=mongodb://localhost:57017/?directConnection=true
